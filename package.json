{
  "name": "algoscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "See every step of your algorithm and how its cost grows.",
  "scripts": {
    "postinstall": "node scripts/sync-pyodide.mjs",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "prebuild": "node scripts/clean-dist.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "check": "npm run lint && npm run format:check && npm run test && npm run test:python && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@uiw/react-codemirror": "^4.25.11",
    "d3-scale": "^4.0.2",
    "motion": "^13.1.1",
    "pyodide": "314.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
